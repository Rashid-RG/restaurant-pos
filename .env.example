# GastroFlow SaaS Production Environment Configuration

# Server Settings
PORT=5000
NODE_ENV=production
# REQUIRED in production. Boot fails fast if missing or left as an insecure default.
# Generate a strong value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
CUSTOMER_JWT_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_STRING
ADMIN_USERNAME=platform_admin
ADMIN_PIN=CHANGE_ME_TO_SIX_RANDOM_DIGITS
# Set 1 only when running behind exactly one trusted reverse proxy.
TRUST_PROXY=0
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD
CORS_ORIGIN=https://pos.yourdomain.com,https://food.yourdomain.com,https://driver.yourdomain.com

# PayHere Payment Gateway Credentials (Sri Lanka)
# The webhook signature check and checkout both resolve to this merchant secret.
# PAYHERE_MERCHANT_SECRET is the canonical name; PAYHERE_SECRET is accepted as an alias.
PAYHERE_MERCHANT_ID=1220000
PAYHERE_MERCHANT_SECRET=CHANGE_ME_PAYHERE_MERCHANT_SECRET
PAYHERE_NOTIFY_URL=https://api.yourdomain.com/api/payments/payhere/webhook
PAYHERE_SANDBOX=true

# Stripe Payment Gateway Credentials (International)
STRIPE_PUBLISHABLE_KEY=pk_test_51Px...
STRIPE_SECRET_KEY=sk_test_51Px...

# SMS & WhatsApp Gateway Credentials (Twilio / Dialog SMS)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Database: production currently supports one application instance with persistent SQLite.
# PostgreSQL/AlloyDB migration is unfinished and blocked in production.
# DATABASE_URL=postgres://user:password@localhost:5432/gastroflow_db
# SQLite container fallback (Docker Compose sets this automatically)
# DATABASE_FILE=/app/data/restaurant.db

# Durable remote libSQL option. Required for the proposed Render deployment.
# Use a compatible libSQL database; do not substitute the new Turso engine.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=enter_in_host_dashboard
